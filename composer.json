{
  "name": "earlyforge/sdk",
  "description": "PHP client for the EarlyForge Trends API (free Pulse mirror and paid full trends feed)",
  "type": "library",
  "license": "MIT",
  "homepage": "https://earlyforge.ai",
  "support": {
    "docs": "https://docs.earlyforge.ai/guides/api/php-sdk",
    "source": "https://github.com/Earlyforge-official/earlyforge/tree/main/sdk-php-earlyforge"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "EarlyForge\\Pulse\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EarlyForge\\Pulse\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
